# Supabase — client-safe keys (RLS is the security boundary).
# Copy this file to .env.local and fill in values from your Supabase project settings.
# Project URL only (no /rest/v1 suffix), e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# Legacy JWT anon key (required by this app today).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Newer publishable key from the Supabase dashboard (optional / future use).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase service role — server-only (webhooks / privileged jobs).
# NEVER expose via NEXT_PUBLIC_*. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Invoice numbering — company prefix for SC-YYYY-XXXX (server-only).
# Defaults to SC when unset. Future company settings can override this.
INVOICE_COMPANY_PREFIX=SC

# ---------------------------------------------------------------------------
# Booking notifications — email (Resend) + WhatsApp Cloud API
# ---------------------------------------------------------------------------
# When RESEND_API_KEY is unset, booking emails are skipped.
RESEND_API_KEY=re_xxxxxxxx
BOOKING_NOTIFICATIONS_FROM=bookings@yourdomain.com
BOOKING_NOTIFICATIONS_FROM_NAME=Silver Carz
BOOKING_NOTIFICATIONS_REPLY_TO=support@yourdomain.com
# Public site URL for links inside emails (e.g. https://silvercarz.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API (Meta). Unset token + phone-number-id skips WhatsApp.
# Create templates in WhatsApp Manager (Utility) using these names:
#   sc_booking_requested      body: Hello {{1}}, we received request {{2}}. Pickup {{3}}, return {{4}}.
#   sc_documents_submitted    body: Hello {{1}}, documents for {{2}} are in. We will review shortly.
#   sc_booking_approved       body: Hello {{1}}, booking {{2}} is confirmed. Pickup {{3}}, return {{4}}. Total {{5}}. Pay when collecting the vehicle. Carry original documents.
#   sc_booking_rejected       body: Hello {{1}}, request {{2}} could not be approved. Reason: {{3}}.
#   sc_payment_collected      body: Hello {{1}}, payment of {{3}} recorded for booking {{2}} via {{4}}. Booking remains confirmed.
#   sc_booking_cancelled      body: Hello {{1}}, booking {{2}} was cancelled ({{3}}).
#   sc_booking_updated        body: Hello {{1}}, booking {{2}} was updated. Pickup {{3}}, return {{4}}.
# These names are what the app sends; create matching templates in Meta. They are not created automatically.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Log payloads without calling Meta (local).
WHATSAPP_DRY_RUN=false
# Session text instead of templates (only inside the 24h customer-care window).
WHATSAPP_SEND_TEXT_FALLBACK=false
# Drain outbox:
#   Authorization: Bearer <secret>
#   POST /api/cron/notifications
NOTIFICATION_CRON_SECRET=
# Meta webhook:
#   GET/POST https://your-domain/api/whatsapp/webhook

# ---------------------------------------------------------------------------
# Admin / staff accounts (database-controlled — not env-driven)
# ---------------------------------------------------------------------------
# Public signup always creates `customer` profiles.
# Only emails in public.staff_allowlist become owner/manager.
#
# After applying migrations, review/adjust allowlist in the Supabase SQL editor:
#
#   SELECT * FROM public.staff_allowlist;
#
#   INSERT INTO public.staff_allowlist (email, role)
#   VALUES ('owner@yourcompany.com', 'owner')
#   ON CONFLICT (email) DO UPDATE SET role = EXCLUDED.role;
#
#   UPDATE public.profiles
#   SET role = 'owner'
#   WHERE lower(email) = lower('owner@yourcompany.com');
#
#   SELECT * FROM public.apply_staff_allowlist();
# ---------------------------------------------------------------------------